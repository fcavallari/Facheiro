msgid "Import and export"
msgstr "Importar e exportar"

#: includes/plugin/class-elderward-admin.php:624
msgid "Export custom signatures"
msgstr "Exportar assinaturas personalizadas"

#: includes/plugin/class-elderward-admin.php:627
msgid "The export is a JSON file. It also works with the standalone scanner: php bin/elderward.php scanall=1 signatures=signatures.json"
msgstr "A exportação é um arquivo JSON. Ele também funciona com a ferramenta de linha de comando independente: php bin/elderward.php scanall=1 signatures=signatures.json"

#: includes/plugin/class-elderward-admin.php:633
#: includes/plugin/class-elderward-admin.php:637
msgid "Import"
msgstr "Importar"

#: includes/plugin/class-elderward-admin.php:635
