msgstr "Marcar um achado como falso positivo"

#: includes/plugin/class-elderward-abilities.php:142
msgid "Remove a false-positive mark"
msgstr "Remover a marcação de falso positivo"

#: includes/plugin/class-elderward-abilities.php:150
msgid "List false-positive marks"
msgstr "Listar falsos positivos"

#: includes/plugin/class-elderward-abilities.php:154
msgid "List signatures"
msgstr "Listar assinaturas"

#: includes/plugin/class-elderward-abilities.php:181
msgid "Test signatures"
msgstr "Testar assinaturas"

#: includes/plugin/class-elderward-abilities.php:190
