#. Description of the plugin
#: elderward.php:12
msgid "Malware scanner and incident response: integrity, database and log checks, server hardening, and a recovery mode for sites that no longer load."
msgstr "Varredura de malware e resposta a incidentes: verificação de integridade, banco de dados e logs, blindagem do servidor e um modo de recuperação para sites que não carregam mais."

#. Author of the plugin
#: elderward.php:16
msgid "Fio Cavallari"
msgstr "Fio Cavallari"

#. Author URI of the plugin
#: elderward.php:17
msgid "https://github.com/fioa8c"
msgstr "https://github.com/fioa8c"

#: includes/plugin/class-elderward-abilities.php:45
msgid "Elderward security"
msgstr "Segurança Elderward"

#: includes/plugin/class-elderward-abilities.php:46
msgid "Malware scanning and incident response with Elderward."
msgstr "Varredura de malware e resposta a incidentes com o Elderward."

#: includes/plugin/class-elderward-abilities.php:94
