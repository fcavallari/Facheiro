#. Description of the plugin
#: facheiro.php
msgid "Varredura de malware e resposta a incidentes: verificação de integridade, banco de dados e logs, blindagem do servidor e um modo de recuperação para sites que não carregam mais."
msgstr "Malware scanner and incident response: integrity, database and log checks, server hardening, and a recovery mode for sites that no longer load."

#. Author of the plugin
#: facheiro.php
msgid "Fio Cavallari"
msgstr "Fio Cavallari"

#. Author URI of the plugin
#: facheiro.php
