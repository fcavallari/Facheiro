msgid_plural "%d falsos positivos salvos são ignorados até que você os revise."
msgstr[0] "%d saved false positive is ignored until you review it."
msgstr[1] "%d saved false positives are ignored until you review them."

#: includes/plugin/class-facheiro-admin.php:992
